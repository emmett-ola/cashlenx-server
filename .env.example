# CashLenX server environment example
# Copy to .env and replace every CHANGE_ME value before starting the server.
# ENV_FILE may select another repository-local file for the lifecycle scripts.

# ============================================================
# Quick Start: Server
# ============================================================

# Runtime mode: dev, test, or prod. Development/test modes allow loopback CORS
# origins and enable schema validation by default; production requires explicit
# origins and defaults schema validation off.
ENV=dev
# TCP port exposed by the API process and container; integer from 1 to 65535.
SERVER_PORT=11063
# Business/display timezone. Accepted formats are UTC, UTC offsets such as
# UTC+8 or UTC-5:30, and IANA names such as Asia/Singapore or America/New_York.
# Invalid values fall back to UTC.
TIMEZONE=UTC
# API route version segment only. v0 produces routes under /api/v0.
API_VERSION=v0

# ============================================================
# Quick Start: MongoDB
# ============================================================

# Database engine selector; valid values are mongodb and mysql.
DB_TYPE=mongodb
# Logical database/schema name. Use a database-safe identifier without spaces.
DB_NAME=cashlenx
# MongoDB bootstrap username and password. Use a URI-safe random value such as
# hexadecimal text for the password; reserved URI characters require encoding.
MONGO_ROOT_USERNAME=cashlenx
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
# MongoDB URI format: mongodb://user:password@host:port/database?options
# authSource=admin is required for the root user created by the dependency image.
# References are expanded by Docker Compose and the Server dotenv loader. Define
# referenced variables first; shell default expressions such as ${VAR:-value}
# are not supported consistently by both loaders.
MONGO_DB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@localhost:27017/${DB_NAME}?authSource=admin&retryWrites=false

# ============================================================
# Required Application Secrets
# ============================================================

# High-entropy signing secret for access tokens. Use at least 32 random bytes;
# for example, generate a value with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Bootstrap administrator credentials. They create the first admin only when no
# administrator exists; changing them later does not rotate an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Comma-separated browser origins. Each entry includes scheme and host; explicit
# ports are recommended in production. A trailing :* wildcard is intended only
# for localhost development clients.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ============================================================
# Optional MySQL Alternative
# ============================================================
# Set DB_TYPE=mysql, then uncomment and replace every CHANGE_ME value.
# MYSQL_ROOT_PASSWORD initializes the database container. MYSQL_USER and
# MYSQL_PASSWORD are the application account. Use URI/DSN-safe random passwords.
# MYSQL_DB_URI uses the Go MySQL DSN form user:password@tcp(host:port); DB_NAME
# is configured separately. References reuse the values defined above them.

# MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
# MYSQL_USER=cashlenx
# MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
# MYSQL_DB_URI=${MYSQL_USER}:${MYSQL_PASSWORD}@tcp(localhost:3306)

# ============================================================
# Optional Runtime Overrides
# ============================================================
# Defaults are shown for discoverability. Uncomment only when overriding them.

# SERVER_HOST is the API process bind address inside its runtime environment;
# 0.0.0.0 listens on every container interface.
# SERVER_HOST=0.0.0.0
# Boolean values are lowercase true or false.
# SCHEMA_VALIDATION=true
# Paths may be relative to the server working directory or absolute.
# LOG_FOLDER=./logs
# Supported Zap levels include debug, info, warn, error, dpanic, panic, and fatal.
# LOG_LEVEL=info
# AUTH_REGISTRATION_ENABLED=true
# Token and verification units are encoded in the key names: minutes, days, and
# seconds respectively. Use positive integers.
# JWT_EXPIRATION_MINUTES=30
# REFRESH_TOKEN_EXPIRATION_DAYS=14
# Unique integer from 0 to 1023 for each concurrently running server instance.
# SNOWFLAKE_WORKER_ID=0
# JSON seed file path, relative to the server working directory unless absolute.
# DEFAULT_CATEGORIES_PATH=config/default_categories.json
# VERIFICATION_CODE_EXPIRE_MINUTES=30
# VERIFICATION_CODE_SEND_INTERVAL_SECONDS=60

# ============================================================
# Optional Server Container Overrides
# ============================================================
# Build-image defaults are owned by docker/images.env.
# Docker image values use repository:tag conventions. Container names must be
# unique on the Docker host.

# BACKEND_CONTAINER_NAME=cashlenx-server
# SERVER_IMAGE_NAME=cashlenx-server
# SERVER_IMAGE_TAG=latest
# Published host interface. Keep 127.0.0.1 when using a host reverse proxy.
# SERVER_BIND_ADDRESS=127.0.0.1
# Host path bind-mounted for container logs.
# SERVER_LOG_PATH=./logs/docker
# Container operating-system timezone for logs and system tools. Use an IANA
# name such as Asia/Singapore; TIMEZONE above separately controls app conversion.
# TZ=Asia/Singapore
# CPU values are decimal cores, memory values use Docker units such as 256m or
# 1g, PID/retry values are positive integers, and time values use Compose
# durations such as 5s, 1m, or 1m30s.
# SERVER_CPU_LIMIT=2.0
# SERVER_CPU_RESERVATION=0.5
# SERVER_MEMORY_LIMIT=1g
# SERVER_MEMORY_RESERVATION=256m
# SERVER_PIDS_LIMIT=256
# SERVER_STOP_GRACE_PERIOD=30s
# SERVER_HEALTHCHECK_INTERVAL=15s
# SERVER_HEALTHCHECK_TIMEOUT=5s
# SERVER_HEALTHCHECK_RETRIES=3
# SERVER_HEALTHCHECK_START_PERIOD=45s

# ============================================================
# Optional Database Container Overrides
# ============================================================
# Image values use Docker repository:tag conventions. Bind addresses and ports
# control host exposure only; keep loopback bindings for local dependencies.
# Health intervals/timeouts/start periods use Compose duration syntax.

# MONGO_IMAGE=mongo:7.0
# MONGO_CONTAINER_NAME=cashlenx-mongodb
# MONGO_BIND_ADDRESS=127.0.0.1
# MONGO_PORT=27017
# MONGO_HEALTHCHECK_INTERVAL=5s
# MONGO_HEALTHCHECK_TIMEOUT=5s
# MONGO_HEALTHCHECK_RETRIES=20
# MONGO_HEALTHCHECK_START_PERIOD=20s

# MYSQL_IMAGE=mysql:8.0
# MYSQL_CONTAINER_NAME=cashlenx-mysql
# MYSQL_BIND_ADDRESS=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_HEALTHCHECK_INTERVAL=5s
# MYSQL_HEALTHCHECK_TIMEOUT=5s
# MYSQL_HEALTHCHECK_RETRIES=20
# MYSQL_HEALTHCHECK_START_PERIOD=20s

# Optional Docker-only connection overrides for external databases. These URIs
# are evaluated from inside the Server container; host.docker.internal reaches
# the Docker host on supported runtimes.
# DOCKER_MONGO_DB_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@host.docker.internal:27017/${DB_NAME}?authSource=admin&retryWrites=false
# DOCKER_MYSQL_DB_URI=${MYSQL_USER}:${MYSQL_PASSWORD}@tcp(host.docker.internal:3306)

# ============================================================
# Optional SMTP
# ============================================================
# SMTP remains disabled unless explicitly enabled and configured.
# SMTP_ENABLED is lowercase true or false. SMTP_HOST is a hostname without a URL
# scheme, SMTP_PORT is an integer such as 465 or 587, and address fields use
# complete email addresses. Retry interval is milliseconds; retry/rate values are
# non-negative integers, and a daily rate of 0 disables that limit.

# SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=CashLenX
# SMTP_MAX_RETRIES=3
# SMTP_RETRY_INTERVAL=1000
# SMTP_RATE_LIMIT_DAILY_PER_IP=5
# SMTP_RATE_LIMIT_DAILY_PER_EMAIL=5
