# CashLenX sample environment file
#
# This file is intended to be copied to `.env` and then adjusted for your machine or deployment.
# Most local developers only need to review the "App Config" and "Database Config" sections.
# Keep comment lines starting with `#`; they are ignored by the loader.


# ============================================================
# No Need To Modify Usually
# ============================================================
# These values mainly control Docker/bootstrap behavior and usually work as-is.

# Services enabled by the helper scripts.
# Common values:
#   mongodb,backend
#   mysql,backend
#   mongodb
#   mysql
ENABLE_SERVICES=mongodb,backend

# Backend container name used by Docker Compose.
BACKEND_CONTAINER_NAME=cashlenx-server

# Docker image / container defaults for MongoDB.
MONGO_VERSION=7.0
MONGO_CONTAINER_NAME=cashlenx-mongodb
MONGO_PORT=27017
MONGO_ROOT_USERNAME=cashlenx
MONGO_ROOT_PASSWORD=cashlenx123

# Docker image / container defaults for MySQL.
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=cashlenx-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=cashlenx123
MYSQL_USER=cashlenx
MYSQL_PASSWORD=cashlenx123


# ============================================================
# System Config
# ============================================================
# These affect how the server process runs.

# API server bind port and host.
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Application timezone used for display/response conversion.
TIMEZONE=UTC

# API version path prefix.
# During active development this project stays on v0.
API_VERSION=v0

# Enable OpenAPI request/response validation middleware.
# Useful in development, but may be disabled in some production setups.
SCHEMA_VALIDATION=true

# Logging output folder and level.
LOG_FOLDER=./logs
LOG_LEVEL=info


# ============================================================
# Database Config
# ============================================================
# DB_TYPE chooses which backend the application uses.
# Valid values: mongodb, mysql
DB_TYPE=mongodb

# Single source of truth for the application database name.
# Docker will derive internal DB init variables from this value when needed.
DB_NAME=cashlenx

# Local application connection URIs.
# These are the values the app uses by default when running outside Docker.
# They assume the database ports are exposed on localhost.
MONGO_DB_URI=mongodb://cashlenx:cashlenx123@localhost:27017/cashlenx?authSource=admin&retryWrites=false
MYSQL_DB_URI=cashlenx:cashlenx123@tcp(localhost:3306)

# Docker Compose persists databases in the managed `mongodb_data` and
# `mysql_data` volumes. This avoids host-directory permission and stale
# credential problems while keeping database state across container recreation.

# Optional Docker-only overrides for the app container.
# You usually do not need these because Compose provides sensible internal defaults.
# Uncomment only if you want the server container to use a custom DB URI.
#
# DOCKER_MONGO_DB_URI=mongodb://cashlenx:cashlenx123@mongodb:27017/cashlenx?authSource=admin&retryWrites=false
# DOCKER_MYSQL_DB_URI=cashlenx:cashlenx123@tcp(mysql:3306)


# ============================================================
# App Config
# ============================================================
# Authentication and application behavior.

# JWT secret used for signing tokens.
# Change this in any real deployment.
JWT_SECRET=your-secret-key-here-change-in-production

# Access-token lifetime in minutes. Keep this short because JWT access tokens
# are stateless and cannot be revoked directly before expiry.
JWT_EXPIRATION_MINUTES=30

# Refresh-token lifetime in days. Refresh tokens are persisted server-side and
# can be revoked on logout, password change, account deletion, or admin action.
REFRESH_TOKEN_EXPIRATION_DAYS=14

# Whether public user registration is enabled.
AUTH_REGISTRATION_ENABLED=true

# Default bootstrap admin credentials.
# The server checks for an admin user on each start and creates one only if none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional path to the default category seed file.
# If omitted, the app falls back to config/default_categories.json.
# DEFAULT_CATEGORIES_PATH=config/default_categories.json

# Worker ID for Snowflake-style distributed ID generation.
# Keep 0 for single-instance local development.
SNOWFLAKE_WORKER_ID=0

# Verification-code lifetime in minutes for password reset and email change.
VERIFICATION_CODE_EXPIRE_MINUTES=30

# Minimum seconds between new verification-code sends for the same purpose/email.
# Use 0 to disable this interval.
VERIFICATION_CODE_SEND_INTERVAL_SECONDS=60

# CORS allowed origins, comma-separated.
# Wildcard localhost ports are supported for development, for example:
#   http://localhost:*
#   http://127.0.0.1:*
#   https://localhost:*
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*


# ============================================================
# Email / External Service Config
# ============================================================
# Email is not the current main project focus, but these are the planned SMTP fields.
# Use values from your provider if you want to test email flows.

SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=no-reply@your-domain.com
SMTP_FROM_NAME=CashLenX

# Retry strategy for email sending.
SMTP_MAX_RETRIES=3
SMTP_RETRY_INTERVAL=1000

# Daily SMTP abuse limits per purpose. Use 0 to disable a limit.
SMTP_RATE_LIMIT_DAILY_PER_IP=5
SMTP_RATE_LIMIT_DAILY_PER_EMAIL=5


# ============================================================
# Misc Notes
# ============================================================
# 1. Copy this file to `.env` before local development.
# 2. For local Go runs, the app loads `.env` directly.
# 3. For Docker server runs, Compose injects `.env` into the container at runtime.
# 4. Do not commit your real `.env`; only commit `.env.sample`.
