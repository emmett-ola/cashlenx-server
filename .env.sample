# ==========================================
# Docker General Configuration
# ==========================================
# Services to enable (mongodb, mysql, backend)
ENABLE_SERVICES=mongodb,backend
# Name of the backend container
BACKEND_CONTAINER_NAME=cashlenx-server

# ==========================================
# Server Configuration
# ==========================================
# Port the server listens on inside the container
SERVER_PORT=8080
# Host binding (0.0.0.0 to allow external connections)
SERVER_HOST=0.0.0.0
# CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Application Timezone
TIMEZONE=UTC

# API Configuration
API_VERSION=v0
SCHEMA_VALIDATION=true

# ==========================================
# Database Connection (Application)
# ==========================================
# Database type to use: mongodb or mysql
DB_TYPE=mongodb
# Database name used by the application
DB_NAME=cashlenx

# Connection URIs
# ------------------------------------------
# OPTION 1: For local CLI/Go usage (running outside Docker)
# Use 'localhost' to connect to exposed ports
MONGO_DB_URI=mongodb://cashlenx:cashlenx123@localhost:27017/cashlenx?authSource=admin&retryWrites=false
MYSQL_DB_URI=cashlenx:cashlenx123@tcp(localhost:3306)

# OPTION 2: For Docker usage (internal networking)
# Use service names 'mongodb' or 'mysql'
# MONGO_DB_URI=mongodb://cashlenx:cashlenx123@mongodb:27017/cashlenx?authSource=admin&retryWrites=false
# MYSQL_DB_URI=cashlenx:cashlenx123@tcp(mysql:3306)

# ==========================================
# MongoDB Docker Configuration
# ==========================================
MONGO_VERSION=7.0
MONGO_CONTAINER_NAME=cashlenx-mongodb
MONGO_PORT=27017
MONGO_ROOT_USERNAME=cashlenx
MONGO_ROOT_PASSWORD=cashlenx123
# Path to store MongoDB data (local bind mount)
MONGO_DATA_PATH=./mongodb/data

# ==========================================
# MySQL Docker Configuration
# ==========================================
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=cashlenx-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=cashlenx123
MYSQL_USER=cashlenx
MYSQL_PASSWORD=cashlenx123
# Path to store MySQL data (local bind mount)
MYSQL_DATA_PATH=./mysql/data

# ==========================================
# Authentication Configuration
# ==========================================
# JWT Secret for token signing (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-secret-key-here-change-in-production
# JWT token expiration time in hours
JWT_EXPIRATION_HOURS=24
# Enable/Disable user registration
AUTH_REGISTRATION_ENABLED=true
# Default admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ==========================================
# Default Categories Configuration
# ==========================================
# Path to default categories JSON file (optional)
# If not specified, defaults to config/default_categories.json
# DEFAULT_CATEGORIES_PATH=config/default_categories.json

# ==========================================
# Snowflake ID Generator Configuration
# ==========================================
# Worker ID for distributed ID generation (0-1023)
# Each instance in a distributed deployment should have a unique worker ID
# Default: 0 (single instance deployment)
SNOWFLAKE_WORKER_ID=0

# ==========================================
# Logging Configuration
# ==========================================
LOG_FOLDER=./logs
LOG_LEVEL=info

# ==========================================
# Email Configuration (SMTP)
# ==========================================
# SMTP Provider Settings (e.g., Mailgun, SendGrid, Gmail)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=no-reply@your-domain.com
SMTP_FROM_NAME=CashLenX

# Email Retry Strategy
# Max retries for failed email attempts
SMTP_MAX_RETRIES=3
# Retry interval in milliseconds
SMTP_RETRY_INTERVAL=1000

